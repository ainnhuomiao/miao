# 推荐：运行 `miao init`（或首次启动时的向导）配置 key，保存在 ~/.miao/credentials，不需要这个文件。
# 这里仅供旧用法参考：key 的查找顺序是 环境变量 MIAO_API_KEY → ~/.miao/credentials → 当前目录 .env。
# 注意：工作区 .env 里的 MIAO_BASE_URL / MIAO_PROTOCOL 会被忽略，连接地址请用真实环境变量或 miao init。
MIAO_API_KEY=
MIAO_BASE_URL=
MIAO_MODEL=
MIAO_WORKSPACE=
MIAO_MODELS=
MIAO_CONTEXT_WINDOW=
MIAO_VISION=
MIAO_ALLOW_COMMANDS=
MIAO_DENY_COMMANDS=
MIAO_FALLBACK_MODEL=
MIAO_NERD_FONT=
MIAO_PROTOCOL=
MIAO_TIMEOUT=
MIAO_MAX_TOOL_ROUNDS=
MIAO_SANDBOX=
MIAO_PRICE_IN=
MIAO_PRICE_OUT=
MIAO_PRICE_CACHE=
MIAO_SESSION_REDACT=
