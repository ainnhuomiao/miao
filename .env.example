# 复制本文件为 .env，然后填入你的 API Key：
#   cp .env.example .env
#
# 默认使用 DeepSeek 的 OpenAI 兼容接口。
# 申请 Key: https://platform.deepseek.com/api_keys

AGENT_API_KEY=sk-your-api-key-here

# 任何兼容 OpenAI Chat Completions 协议的服务都可以：
#   DeepSeek: https://api.deepseek.com
#   OpenAI:   https://api.openai.com/v1
#   Ollama:   http://localhost:11434/v1   （Key 随便填，例如 ollama）
AGENT_BASE_URL=https://api.deepseek.com

# 模型名：
#   DeepSeek: deepseek-chat（通用） / deepseek-reasoner（推理）
#   OpenAI:   gpt-4o-mini
#   Ollama:   qwen2.5:7b
AGENT_MODEL=deepseek-chat

# 工具可访问的工作区根目录（默认当前工作目录）
# AGENT_WORKSPACE=/path/to/project
